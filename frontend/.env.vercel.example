# Vercel UI → Render API
# Browser HTTP: set NEXT_PUBLIC_WS_ORIGIN so the client calls Render directly.
# Vercel Deployment Protection blocks same-origin /api/* (returns login HTML).
# Local dev: omit NEXT_PUBLIC_WS_ORIGIN — browser uses /api proxy to localhost:8000.
# Server-side (SSR): HVAC_API_ORIGIN only.

HVAC_API_ORIGIN=https://hvac-api-elin.onrender.com
NEXT_PUBLIC_WS_ORIGIN=https://hvac-api-elin.onrender.com

# Do NOT set NEXT_PUBLIC_API_URL on Vercel — it forces cross-origin browser fetches and CORS errors.
