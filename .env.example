# Copy to .env and fill locally. Never commit secrets.

HVAC_ENV=development
HVAC_DEPLOYMENT_MODE=local
HVAC_ALLOW_DEFAULT_USERS=0
HVAC_DEFAULT_BUILDING_ID=bldg-corp-hq-01

HVAC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Hosted UI: HVAC_CORS_ORIGIN_REGEX=https://.*\.(vercel\.app|onrender\.com)

HVAC_SAFE_MODE=0
# Dataset (simulation) vs production: HVAC_BMS_MODE=production or header Live BMS.
# Keep HVAC_BMS_WRITE_ENABLED=0 until mapping and safety review are done.
# Phase 4: set to 1, then POST /api/platform/bms/write-enable {"confirm": true}.
# Dataset mode and SAFE MODE still cannot write.
HVAC_BMS_MODE=simulation
# Stage A: BACnet/IP only. Modbus/KNX are out of scope until a site requires them.
HVAC_BMS_PROTOCOL=bacnet
HVAC_BMS_CONNECTED=0
HVAC_BMS_WRITE_ENABLED=0
HVAC_ALLOW_SIM_WRITES=0
HVAC_USE_SIMULATION=0
HVAC_PLANT_MODE_PERSIST=1
# Header Dataset vs Live BMS writes PLANT_MODE when persist=1.
HVAC_START_CONTROL_WORKER=1
# NB2 pipeline (default): RLS → LSTM → Safe RL → Rule Engine → BMS Control
HVAC_USE_AI_PIPELINE=1
HVAC_AI_PIPELINE_INTERVAL_SECONDS=60
HVAC_AI_PIPELINE_ZONES=ZONE-01
# Auto approve→apply→verify in simulation when HVAC_ALLOW_SIM_WRITES=1; set 1 for live writes
HVAC_AI_PIPELINE_AUTO_DISPATCH=0
# Production: 0. Development may set 1 until all tables are in Alembic.
HVAC_ALLOW_CREATE_ALL=0
HVAC_ALLOW_DB_RESET=0
HVAC_TELEMETRY_STALE_SECONDS=90
HVAC_DISPATCH_CONFIDENCE_MIN=0.65
HVAC_TELEMETRY_RETAIN_DAYS=90
HVAC_TELEMETRY_PURGE=0
# Stage B AI-ready data: in-memory ring buffer (seconds / max samples per point).
HVAC_TS_BUFFER_SECONDS=7200
HVAC_TS_BUFFER_MAX=720
# Window: GET /api/platform/timeseries/window?point_id=...&t0=...&t1=...
# Normalized AI rows: GET /api/platform/ai/normalized?zone_id=ZONE-01&t0=...&t1=...
# Stage C RLS (online learning — never writes setpoints):
HVAC_RLS_LAMBDA=0.995
HVAC_RLS_MIN_UPDATES=20
HVAC_RLS_TICK_SECONDS=60
HVAC_RLS_ERROR_REJECT=500
# GET /api/platform/ai/rls/status | /params | /errors
# Stage D LSTM (advisory forecast — never writes setpoints):
HVAC_LSTM_LOOKBACK_MIN=60
HVAC_LSTM_TRAIN_HOURS=48
HVAC_LSTM_EPOCHS=40
HVAC_LSTM_MAE_READY_TEMP=1.5
HVAC_LSTM_MAE_READY_POWER=25
HVAC_LSTM_MAE_READY_OCC=0.25
# When 1, train/forecast refuse without torch (TORCH_REQUIRED). Default 0 = soft optional.
HVAC_LSTM_REQUIRE_TORCH=0
# Requires: pip install -r backend/requirements-lstm.txt
# GET /api/platform/ai/lstm/forecast | /status | /sequence ; POST /api/platform/ai/lstm/train
# Stage E Safe RL (recommend only — never writes setpoints):
HVAC_SAFE_RL_TICK_SECONDS=60
# >0 enables job_worker full pipeline cycle (RLS→LSTM→SafeRL→Rules→dispatch)
HVAC_TOU_TARIFF_USD_KWH=0.14
HVAC_COMFORT_MIN_C=21
HVAC_COMFORT_MAX_C=24
HVAC_SAFE_RL_MIN_CONFIDENCE=0.65
HVAC_SAFE_RL_SCORE_W_ENERGY=1.0
HVAC_SAFE_RL_SCORE_W_COMFORT=2.0
HVAC_SAFE_RL_MAX_COMFORT_RISK=0.85
# POST /api/platform/ai/safe-rl/recommend | GET /status | /decisions
# Free LLM narrative (operator explanations — NOT the NB2 optimizer)
# template = zero config; auto = ollama → groq/gemini/openrouter (if keys) → template
HVAC_LLM_ENABLED=1
HVAC_LLM_PROVIDER=auto
# HVAC_LLM_MODEL=gemini-flash-latest
# GEMINI_API_KEY=              # Google AI Studio (X-goog-api-key header)
# HVAC_LLM_API_KEY=            # Or set here for any provider
# HVAC_LLM_BASE_URL=          # Ollama default http://127.0.0.1:11434
# Free keys: Groq https://console.groq.com | Gemini https://aistudio.google.com/apikey
# Local free: install Ollama → ollama pull llama3.2

# Stage F Rule Engine (no BMS write without APPROVED):
HVAC_EMERGENCY_STOP=0
HVAC_MANUAL_OVERRIDE=0
HVAC_SCHEDULE_START_HOUR=8
HVAC_SCHEDULE_END_HOUR=18
HVAC_RULE_ENGINE_STRICT=1
# POST /api/platform/rules/evaluate | GET /api/platform/rules/audit

# Stage G controlled writes (one-point supervised lifecycle):
# First writable point only. Expand AHU-01.sat_setpoint after verify_stats expand_ready.
HVAC_STAGE_G_ENFORCE=1
HVAC_STAGE_G_WRITABLE_POINTS=ZONE-01.cooling_setpoint
HVAC_STAGE_G_AUTO_ROLLBACK=1
HVAC_STAGE_G_VERIFY_SUCCESS_MIN=0.9
HVAC_STAGE_G_VERIFY_WINDOW=10
# GET /api/platform/bms/stage-g/status
# POST /api/platform/commands/{id}/approve|apply|verify|rollback
# Keep HVAC_BMS_WRITE_ENABLED=0 until G1 checklist + mapping review; then ENABLE WRITES on /platform/bms.

# Stage H closed loop (Level 8 ≈95%):
# H1 post-VERIFIED RLS feedback (lag then lookback tick)
HVAC_RLS_POST_WRITE_LAG_SECONDS=300
HVAC_RLS_POST_WRITE_LOOKBACK=30
# H2 LSTM daily retrain from historian + version bump
HVAC_LSTM_RETRAIN_SECONDS=86400
HVAC_LSTM_RETRAIN_HOURS=168
# H3 Safe RL realized reward → offline scorer weight/prior update
HVAC_SAFE_RL_OFFLINE_SECONDS=3600
HVAC_SAFE_RL_OFFLINE_ALPHA=0.1
HVAC_SAFE_RL_REWARD_W_ENERGY=1.0
HVAC_SAFE_RL_REWARD_W_COMFORT=2.0
HVAC_SAFE_RL_REWARD_W_EQUIPMENT=0.5
# H4 edge posture (optional cloud)
HVAC_EDGE_MODE=0
HVAC_CLOUD_URL=
# H5 AI watchdogs
HVAC_AI_WATCHDOG_STALE_SECONDS=600
# GET /api/platform/edge/status | /ai/lstm/models | /readyz (ai_watchdogs)
# Edge package: docker compose --profile edge up postgres api-edge control-worker-edge job-worker-edge

# --- Stage A (Level 1 live path) ---
# Switch UI/header to Live BMS (plant mode LIVE_BMS), keep writes off, then:
#   HVAC_BMS_LAB=1
#   HVAC_BMS_MODE=production
#   HVAC_BACNET_HOST=127.0.0.1
#   HVAC_BACNET_PORT=47808
# Lab gateway stamps LIVE_BMS (not the dataset simulator). Run:
#   python scripts/stage_a_commission.py
# Real BAC0 device: set HVAC_BMS_LAB=0, install backend/requirements-bacnet.txt, set HVAC_BACNET_HOST.
HVAC_BMS_LAB=0
# HVAC_BACNET_HOST=
# HVAC_BACNET_PORT=47808
# HVAC_MQTT_URL=
# HVAC_OPCUA_URL=

OPENWEATHER_API_KEY=
FACILITY_NAME=Senatria Corporation
FACILITY_CITY=Bengaluru
FACILITY_LOCATION=Bengaluru, Karnataka, India
FACILITY_TIMEZONE=Asia/Kolkata
FACILITY_LAT=12.9716
FACILITY_LON=77.5946

NEXT_PUBLIC_API_URL=http://localhost:8000/api
